<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/sl_input_box_stroke</item>
        <item name="boxStrokeErrorColor">@color/inputErrorBorder</item>
        <item name="errorTextColor">@color/inputErrorText</item>
        <item name="errorIconTint">@color/inputErrorIcon</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.Error</item>
        <item name="android:textColorHint">@color/inputHint</item>
        <item name="placeholderTextColor">@color/inputHint</item>
        <item name="hintTextColor">@color/inputFloatingHint</item>
    </style>

    <style name="TextAppearance.App.Error" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/inputErrorText</item>
    </style>
</resources>